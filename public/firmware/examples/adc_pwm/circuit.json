{
  "version": 1,
  "name": "Firmware: adc_pwm",
  "description": "Execute the included Arduino sketch. Use the Firmware panel Run and interactive controls.",
  "components": [
    {
      "id": "ESP1",
      "type": "firebeetle_esp32e"
    },
    {
      "id": "RV1",
      "type": "potentiometer",
      "holes": [
        "a8",
        "a9",
        "a10"
      ],
      "params": {
        "resistance": 10000,
        "position": 0.5
      }
    },
    {
      "id": "P1",
      "type": "scope_probe",
      "holes": [
        "d9"
      ],
      "params": {
        "channel": 1
      }
    },
    {
      "id": "R2",
      "type": "resistor",
      "holes": [
        "j14",
        "j18"
      ],
      "params": {
        "resistance": 330
      }
    },
    {
      "id": "LED1",
      "type": "led",
      "holes": [
        "i18",
        "i22"
      ],
      "params": {
        "color": "red"
      }
    }
  ],
  "wires": [
    {
      "id": "W1",
      "from": "ESP1:GND",
      "to": "c8",
      "color": "black"
    },
    {
      "id": "W2",
      "from": "ESP1:3V3",
      "to": "c10",
      "color": "red"
    },
    {
      "id": "W3",
      "from": "ESP1:GPIO34",
      "to": "c9",
      "color": "green"
    },
    {
      "id": "W4",
      "from": "ESP1:GPIO2",
      "to": "h14",
      "color": "green"
    },
    {
      "id": "W5",
      "from": "ESP1:GND",
      "to": "j22",
      "color": "black"
    }
  ],
  "board": "half"
}
