{
  "version": 1,
  "board": "half",
  "name": "FireBeetle GPIO2 LED blink",
  "description": "USB-powered FireBeetle. Run simulation, select ESP1 and use GPIO controls to switch GPIO2 LOW/HIGH/PWM. GPIO2 drives the onboard LED and a red LED through 330 ohms.",
  "components": [
    {
      "id": "ESP1",
      "type": "firebeetle_esp32e",
      "params": {
        "gpio2_mode": "pwm",
        "gpio2_frequency": 1,
        "gpio2_duty": 0.5
      }
    },
    {
      "id": "R1",
      "type": "resistor",
      "holes": [
        "j10",
        "j14"
      ],
      "params": {
        "resistance": 330
      }
    },
    {
      "id": "LED1",
      "type": "led",
      "holes": [
        "i14",
        "i18"
      ],
      "params": {
        "color": "red"
      }
    },
    {
      "id": "P1",
      "type": "scope_probe",
      "holes": [
        "a10"
      ],
      "params": {
        "channel": 1
      }
    }
  ],
  "wires": [
    {
      "id": "W1",
      "from": "ESP1:GPIO2",
      "to": "h10",
      "color": "green"
    },
    {
      "id": "W2",
      "from": "ESP1:GND",
      "to": "j18",
      "color": "black"
    },
    {
      "id": "W3",
      "from": "g10",
      "to": "b10",
      "color": "yellow"
    }
  ]
}
