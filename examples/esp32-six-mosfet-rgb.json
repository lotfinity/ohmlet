        "x": -26,
        "z": -3
      },
      "params": {
        "gpio25_mode": "pwm",
        "gpio25_frequency": 100,
        "gpio25_duty": 0.8,
        "gpio26_mode": "pwm",
        "gpio26_frequency": 100,
        "gpio26_duty": 0.5,
        "gpio14_mode": "pwm",
